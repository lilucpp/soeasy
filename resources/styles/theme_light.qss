/* ==========================================================================
   SoEasy Design System - Light Theme (theme_light.qss)
   Strictly aligned with Figma Design Tokens (opt.css)
   Zero Hardcoding: Managed entirely via objectName & dynamic properties
   ========================================================================== */

/* --- 1. Global Base Styles --- */
QWidget {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: 13px;
    color: #1E293B;
    selection-background-color: #EFF6FF;
    selection-color: #2563EB;
}

/* Master Background Surfaces (Never Transparent to avoid X11 black buffer artifacts) */
QMainWindow,
QWidget#centralWidget,
QWidget#WorkspaceStack,
QWidget#SearchWorkspace {
    background-color: #F8FAFC;
}

/* Master Splitter: Subtle spacing between left & right cards */
QSplitter#WorkspaceSplitter {
    background-color: transparent;
}
QSplitter#WorkspaceSplitter::handle {
    background-color: transparent;
    width: 12px;
}

/* Master-Detail Independent White Floating Cards */
QWidget#LeftResultsPane {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

/* Global Tooltip */
QToolTip {
    background-color: #1E293B;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 11px;
}

/* Global ScrollBar */
QScrollBar:vertical {
    width: 6px;
    background: transparent;
    margin: 0;
    padding: 0;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 28px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    height: 0px;
    background: transparent;
}

QScrollBar:horizontal {
    height: 6px;
    background: transparent;
    margin: 0;
    padding: 0;
}
QScrollBar::handle:horizontal {
    background: #CBD5E1;
    min-width: 28px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    width: 0px;
    background: transparent;
}

/* --- 2. Window TitleBar (#TitleBar) --- */
#TitleBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    min-height: 48px;
    max-height: 48px;
}

#TitleBar #BrandTitle {
    font-size: 14px;
    font-weight: 700;
    color: #0F172A;
}

#TitleBar #BrandDivider {
    background-color: #E2E8F0;
    max-width: 1px;
    min-width: 1px;
    max-height: 14px;
    min-height: 14px;
}

#TitleBar #BrandSlogan {
    font-size: 12px;
    color: #64748B;
}

/* TitleBar Window Action Buttons */
#TitleBar QPushButton[role="win-control"] {
    background: transparent;
    border: none;
    border-radius: 4px;
    min-width: 32px;
    max-width: 32px;
    min-height: 28px;
    max-height: 28px;
    color: #64748B;
}
#TitleBar QPushButton[role="win-control"]:hover {
    background-color: #F1F5F9;
    color: #0F172A;
}
#TitleBar QPushButton[role="win-close"]:hover {
    background-color: #EF4444;
    color: #FFFFFF;
}

/* --- 3. Search Control Panel (#SearchControlPanel) --- */
#SearchControlPanel {
    background-color: transparent;
    padding: 0;
}

/* Search Input Box */
#SearchInputWrap {
    background-color: #FFFFFF;
    border: 1.5px solid #CBD5E1;
    border-radius: 6px;
    padding: 0 12px;
    min-height: 42px;
    max-height: 42px;
}
#SearchInputWrap:focus-within {
    border: 1.5px solid #2563EB;
}

#SearchInput {
    border: none;
    background: transparent;
    font-size: 14px;
    font-weight: 500;
    color: #0F172A;
    padding: 0;
}
#SearchInput:focus {
    outline: none;
}

/* Keyboard hint badge */
QLabel[role="kbd-badge"] {
    background-color: #F1F5F9;
    color: #64748B;
    border: 1px solid #E2E8F0;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: 500;
}

/* Path Filter Scope Bar */
#PathInputWrap {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 0 10px;
    min-height: 32px;
    max-height: 32px;
}
#PathInputWrap:focus-within {
    border: 1px solid #2563EB;
}

#PathInput {
    border: none;
    background: transparent;
    font-size: 12px;
    color: #202B3C;
}
#PathInput:focus {
    outline: none;
}

/* --- 4. Semantic Buttons --- */
QPushButton {
    font-size: 13px;
    border-radius: 6px;
    padding: 0 14px;
    min-height: 32px;
}

/* Primary Action Button (Solid Blue) */
QPushButton[role="primary"] {
    background-color: #2765D5;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}
QPushButton[role="primary"]:hover {
    background-color: #1E51B3;
}
QPushButton[role="primary"]:pressed {
    background-color: #174396;
}

/* Secondary Button (Bordered Gray) */
QPushButton[role="secondary"] {
    background-color: #FFFFFF;
    color: #687589;
    border: 1px solid #C8D0DC;
    font-weight: 500;
}
QPushButton[role="secondary"]:hover {
    background-color: #F6F7F9;
    color: #202B3C;
    border-color: #B0BAC9;
}
QPushButton[role="secondary"]:pressed {
    background-color: #EDF1F5;
}

/* Danger Button (Outlined Red) */
QPushButton[role="danger"] {
    background-color: #FFFFFF;
    color: #BE4545;
    border: 1px solid #BE4545;
    font-weight: 600;
}
QPushButton[role="danger"]:hover {
    background-color: #BE4545;
    color: #FFFFFF;
}

/* Segmented Control Buttons (FullText / Filename) */
QFrame[role="segmented-group"] {
    background-color: #F6F7F9;
    border: 1px solid #E4E8EE;
    border-radius: 6px;
    padding: 2px;
}

QPushButton[role="segment-btn"] {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #687589;
    font-size: 13px;
    font-weight: 500;
    min-height: 28px;
    padding: 0 14px;
}
QPushButton[role="segment-btn"][active="true"] {
    background-color: #FFFFFF;
    color: #2765D5;
    font-weight: 600;
    border: 1px solid rgba(0, 0, 0, 0.04);
}

/* Action Toggle Buttons (Preview Toggle, Settings Entry) */
QPushButton[role="action-toggle"] {
    background-color: #FFFFFF;
    border: 1px solid #E4E8EE;
    border-radius: 6px;
    color: #687589;
    font-size: 13px;
    font-weight: 500;
    padding: 0 12px;
    min-height: 38px;
}
QPushButton[role="action-toggle"]:hover {
    background-color: #F6F7F9;
    color: #202B3C;
    border-color: #C8D0DC;
}
QPushButton[role="action-toggle"][active="true"] {
    background-color: #EBF2FE;
    border-color: #2765D5;
    color: #2765D5;
    font-weight: 600;
}

/* --- 5. Search Results TableView (#ResultView) & Summary Bar --- */
#ResultSummaryBar {
    background-color: #FFFFFF;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom: 1px solid #F1F5F9;
    min-height: 40px;
    max-height: 40px;
    padding: 0 16px;
}
#ResultSummaryLabel {
    font-size: 13px;
    color: #1E293B;
}
#SortComboBox {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 3px 12px;
    font-size: 12px;
    color: #64748B;
    min-height: 28px;
}
#SortComboBox::drop-down {
    border: none;
    width: 16px;
}

#ResultView {
    background-color: #FFFFFF;
    border: none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    outline: none;
    font-size: 13px;
}
#ResultView::item {
    border-bottom: 1px solid #F1F5F9;
    padding: 4px 12px;
}
#ResultView::item:hover {
    background-color: #F8FAFC;
}
#ResultView::item:selected {
    background-color: #EFF6FF;
    color: #1E293B;
}

QHeaderView::section {
    background-color: #FFFFFF;
    color: #64748B;
    font-size: 11px;
    font-weight: 500;
    border: none;
    border-bottom: 1px solid #F1F5F9;
    padding: 6px 12px;
}

/* --- 6. Content Preview Panel (#PreviewPanel) --- */
#PreviewPanel {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

#PreviewHeaderBar {
    background-color: #FFFFFF;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom: 1px solid #E2E8F0;
    padding: 14px 20px;
}

#PreviewFileTitle {
    font-size: 16px;
    font-weight: 700;
    color: #0F172A;
}

#PreviewFilePath {
    font-size: 11px;
    color: #64748B;
}

#BtnCopyPath {
    background: transparent;
    border: none;
    color: #64748B;
    font-size: 13px;
    padding: 0 4px;
}
#BtnCopyPath:hover {
    color: #2563EB;
}

#KeywordNavBar {
    background-color: #F8FAFC;
    border-bottom: 1px solid #E2E8F0;
    min-height: 40px;
    max-height: 40px;
    padding: 0 20px;
}

#KeywordPill {
    background-color: #FEF08A;
    color: #854D0E;
    font-size: 11px;
    font-weight: 600;
    border-radius: 4px;
    padding: 2px 8px;
}

#SourceCodeViewer {
    background-color: #FFFFFF;
    border: none;
    font-family: 'JetBrains Mono', Consolas, Monaco, monospace;
    font-size: 12px;
    line-height: 20px;
    color: #1E293B;
}

#PreviewFooterBar {
    background-color: #F8FAFC;
    border-top: 1px solid #E2E8F0;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    min-height: 32px;
    max-height: 32px;
    padding: 0 20px;
    font-size: 11px;
    color: #64748B;
}

/* --- 7. Global StatusBar (#GlobalStatusBar) --- */
#GlobalStatusBar, QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E2E8F0;
    min-height: 32px;
    max-height: 32px;
    padding: 0 16px;
    font-size: 11px;
    color: #64748B;
}

/* Status Indicator Dot */
QLabel[role="status-dot-ready"] {
    min-width: 6px;
    max-width: 6px;
    min-height: 6px;
    max-height: 6px;
    border-radius: 3px;
    background-color: #2E8A67;
}

/* Privacy Badge Label */
QLabel[role="privacy-label"] {
    color: #2E8A67;
    font-weight: 500;
    font-size: 11px;
}

/* --- 8. Hover Preview Popup (#HoverPreviewPopup) --- */
#HoverPreviewPopup #PreviewCard {
    background-color: #FFFFFF;
    border: 1px solid #C8D0DC;
    border-radius: 8px;
}

#HoverPreviewPopup #SnippetBox {
    background-color: #F6F7F9;
    border: 1px solid #E4E8EE;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 12px;
    line-height: 1.5;
    color: #202B3C;
}

/* --- 9. Settings Workspace (#SettingsWorkspace) --- */
#SettingsDialog,
#SettingsBodyWidget,
#SettingsTabWidget,
#SettingsTabWidget::pane,
#SettingsTabPage,
#SettingsScrollArea,
QTabWidget::pane {
    background-color: #FAFBFC;
    border: none;
}

QScrollArea,
QScrollArea > QWidget,
QScrollArea > QWidget > QWidget {
    background-color: #FAFBFC;
    border: none;
}

#SettingsSidebar {
    background-color: #F6F7F9;
    border-right: 1px solid #E4E8EE;
    min-width: 210px;
    max-width: 210px;
    padding: 16px 12px;
}

#SettingsBackButton {
    background: transparent;
    border: 1px solid #E4E8EE;
    border-radius: 6px;
    color: #687589;
    font-size: 13px;
    min-height: 32px;
    padding: 0 10px;
}
#SettingsBackButton:hover {
    background-color: #FFFFFF;
    color: #2765D5;
    border-color: #BCD0F6;
}

QPushButton[role="nav-item"] {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #687589;
    font-size: 13px;
    font-weight: 500;
    min-height: 38px;
    text-align: left;
    padding-left: 12px;
}
QPushButton[role="nav-item"]:hover {
    background-color: #F0F3F7;
    color: #202B3C;
}
QPushButton[role="nav-item"][active="true"] {
    background-color: #EBF2FE;
    color: #2765D5;
    font-weight: 600;
}

/* Settings Content Surface */
#SettingsContentArea {
    background-color: #FAFBFC;
    padding: 28px 36px;
}

/* Modular Setting Card */
QFrame[surface="card"] {
    background-color: #FFFFFF;
    border: 1px solid #E4E8EE;
    border-radius: 8px;
    padding: 18px 20px;
}

QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E4E8EE;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px;
    font-size: 13px;
    font-weight: 600;
    color: #202B3C;
}

/* Danger Zone Card */
QFrame[surface="danger-card"] {
    background-color: #FEF2F2;
    border: 1px solid #FECACA;
    border-radius: 8px;
    padding: 16px 20px;
}

QLabel[role="danger-title"] {
    color: #DC2626;
    font-size: 13px;
    font-weight: 600;
}
QLabel[role="danger-desc"] {
    color: #687589;
    font-size: 12px;
}

/* --- 10. Form & Input Controls --- */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #C8D0DC;
    border-radius: 6px;
    padding: 0 10px;
    min-height: 32px;
    color: #202B3C;
    font-size: 13px;
    selection-background-color: #E6EEFC;
    selection-color: #2765D5;
}
QLineEdit:hover {
    border-color: #94A3B8;
}
QLineEdit:focus {
    border: 1.5px solid #2765D5;
    outline: none;
}
QLineEdit:disabled {
    background-color: #F6F7F9;
    color: #8C97A6;
    border-color: #E4E8EE;
}

QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #C8D0DC;
    border-radius: 6px;
    padding: 0 10px;
    min-height: 32px;
    color: #202B3C;
    font-size: 13px;
}
QSpinBox:hover {
    border-color: #94A3B8;
}
QSpinBox:focus {
    border: 1.5px solid #2765D5;
    outline: none;
}
QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    background: transparent;
    border: none;
}

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #C8D0DC;
    border-radius: 6px;
    padding: 0 12px;
    min-height: 32px;
    color: #202B3C;
    font-size: 13px;
}
QComboBox:hover {
    border-color: #94A3B8;
}
QComboBox:focus {
    border: 1.5px solid #2765D5;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: none;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #C8D0DC;
    border-radius: 6px;
    selection-background-color: #E6EEFC;
    selection-color: #2765D5;
    outline: none;
    padding: 4px;
}
QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 8px;
    border-radius: 4px;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #F6F7F9;
    color: #202B3C;
}

QCheckBox {
    spacing: 8px;
    font-size: 13px;
    color: #202B3C;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1.5px solid #C8D0DC;
    background-color: #FFFFFF;
}
QCheckBox::indicator:hover {
    border-color: #2765D5;
}
QCheckBox::indicator:checked {
    background-color: #2765D5;
    border-color: #2765D5;
}

/* --- 11. Tree & List & Table Controls --- */
QListWidget, QTreeWidget, QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E4E8EE;
    border-radius: 6px;
    outline: none;
    font-size: 13px;
    color: #202B3C;
}
QListWidget::item, QTreeWidget::item {
    min-height: 32px;
    padding: 4px 8px;
    border-radius: 4px;
}
QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: #F6F7F9;
}
QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #E6EEFC;
    color: #2765D5;
}
QTableWidget::item {
    padding: 6px 10px;
    border-bottom: 1px solid #F0F3F7;
}
QTableWidget::item:selected {
    background-color: #E6EEFC;
    color: #202B3C;
}

QGroupBox {
    font-weight: 600;
    font-size: 13px;
    color: #202B3C;
    border: 1px solid #E4E8EE;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 16px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 6px;
    background-color: #FFFFFF;
}

/* --- 12. Settings Dialog Specific Components --- */
#SettingsDialog {
    background-color: #F6F7F9;
}

#SettingsNavList {
    background-color: #F6F7F9;
    border: none;
    border-right: 1px solid #E4E8EE;
    outline: none;
    padding: 12px 8px;
}
#SettingsNavList::item {
    min-height: 40px;
    border-radius: 6px;
    padding-left: 12px;
    font-size: 13px;
    font-weight: 500;
    color: #687589;
    margin-bottom: 4px;
}
#SettingsNavList::item:hover {
    background-color: #EDF1F5;
    color: #202B3C;
}
#SettingsNavList::item:selected {
    background-color: #EBF2FE;
    color: #2765D5;
    font-weight: 600;
}

#SettingsBottomBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E4E8EE;
    min-height: 52px;
    max-height: 52px;
    padding: 0 20px;
}

