prefix=/usr
exec_prefix=${prefix}
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include

Name: Cap'n Proto
Description: Insanely fast serialization system compiler library
Version: 1.0.1
Libs: -L${libdir} -lcapnpc   
Libs.private: -latomic  
Requires: kj = 1.0.1
Cflags: -I${includedir}   
